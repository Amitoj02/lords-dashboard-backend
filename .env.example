# ───────────────────────────────────────────────────────────────────────────
# Lords Dashboard API — environment template
# Copy to `.env` and fill in real values. NEVER commit a real .env file.
# ───────────────────────────────────────────────────────────────────────────

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed CORS origins (the Angular dev server)
CORS_ORIGINS=http://localhost:4200

# --- Database (MySQL / XAMPP defaults) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=lords_dashboard
# Keep synchronize OFF — schema is owned by migrations.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT (session tokens we issue after Discord login) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Encryption at rest (AES-256-GCM) for Discord tokens + event passwords ---
# MUST be 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-me-with-64-hex-characters-0000000000000000000000000000

# --- Discord OAuth2 ---
# Create an application at https://discord.com/developers/applications
# OAuth2 → add redirect: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback
# Space-separated OAuth2 scopes. `identify` is required; `email` and `guilds` are recommended.
DISCORD_SCOPES=identify email guilds
# The regiment's Discord server (guild) ID — used to verify membership on login (optional).
DISCORD_GUILD_ID=

# --- Frontend redirect targets (where we send the browser after OAuth) ---
FRONTEND_URL=http://localhost:4200
# Where to land an authenticated user; the JWT is appended as a short-lived handoff.
FRONTEND_AUTH_SUCCESS_REDIRECT=http://localhost:4200/auth/callback
FRONTEND_AUTH_FAILURE_REDIRECT=http://localhost:4200/login

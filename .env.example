# ───────────────────────────────────────────────────────────────────────────
# Lords Dashboard API — environment template
#
# The stack is Docker-first: `docker compose up` boots api + MySQL 8 + web with
# throwaway dev secrets baked into docker-compose.yml — you do NOT need a .env
# for local development. This file documents every variable and is the template
# for a PRODUCTION deploy (copy to a host .env consumed by docker-compose.prod.yml).
# NEVER commit a real .env.
#
# To run the API on the HOST (outside Docker) instead, copy this to `.env`, point
# DB_HOST at a reachable MySQL 8 (e.g. the compose `db` mapped to 127.0.0.1:3307),
# and run `npm run db:setup && npm run start:dev`.
# ───────────────────────────────────────────────────────────────────────────

# --- Application ---
NODE_ENV=development
PORT=3000
# Host port the api is published on by docker compose (the container itself
# always listens on PORT above). Override if 3000 is taken on your host
# (e.g. Grafana). Defaults to 3000 when unset.
API_HOST_PORT=3001
API_PREFIX=api
# Comma-separated allowed CORS origins. In the proxied topology the browser is
# same-origin with the api (the web container proxies /api), so this is the web
# origin: dev http://localhost:4200, prod https://lordsofholdfast.com
CORS_ORIGINS=http://localhost:4200

# --- Database (MySQL 8, the compose `db` service) ---
# DB_HOST=db inside the compose network; 127.0.0.1 + DB_PORT=3307 from the host.
DB_HOST=db
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=devpassword
DB_DATABASE=lords_dashboard
# Keep synchronize OFF — schema is owned by migrations.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT (session tokens we issue after Discord login) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Encryption at rest (AES-256-GCM) for Discord tokens + event passwords ---
# MUST be 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-me-with-64-hex-characters-0000000000000000000000000000

# --- Discord OAuth2 ---
# Create an application at https://discord.com/developers/applications
# OAuth2 → add redirect: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback
# Space-separated OAuth2 scopes. `identify` is required; `email` is recommended.
# NOTE: no `guilds` scope — guild membership is resolved from the bot at sign-in
# (fetchMember), so the consent screen never asks "know what servers you're in".
DISCORD_SCOPES=identify email
# The regiment's Discord server (guild) ID — used to verify membership on login
# (the bot looks the user up in this guild). Leave blank to skip the check.
DISCORD_GUILD_ID=

# --- Discord MOCK (dev / no Discord app required) ---
# When true, the OAuth2 network calls are replaced by an in-process mock so the
# whole sign-in → JWT → /auth/me flow works with NO real Discord application.
# Leave unset to auto-enable the mock whenever DISCORD_CLIENT_ID is empty.
# TO GO LIVE: set DISCORD_MOCK=false and fill in real CLIENT_ID/CLIENT_SECRET.
DISCORD_MOCK=true
# Which canned persona the mock signs in as by default. `owner` resolves the
# seeded Owner member (full admin); `recruit` is a non-member (lands on /apply).
# Any other value (e.g. via /api/auth/discord?as=alice) is a stable synthetic user.
DISCORD_MOCK_DEFAULT_PERSONA=owner

# --- Discord BOT / gateway (the "Quartermaster" — role sync + announcements) ---
# The bot has NO slash commands: members use the webapp. It only syncs Discord
# roles from app rank/role/medal changes and posts announcements to a channel.
# Leave the token blank to run the in-process MOCK gateway (no network, no bot).
# TO GO LIVE: provide DISCORD_BOT_TOKEN + DISCORD_APPLICATION_ID and set
# DISCORD_BOT_MOCK=false. The bot needs the GUILD_MEMBERS privileged intent and
# must sit above every role it manages.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Leave unset to auto-enable the mock whenever DISCORD_BOT_TOKEN is empty.
DISCORD_BOT_MOCK=true

# --- Object storage (MinIO in dev, Cloudflare R2 in prod) ---
# TWO DISTINCT HOSTS, and confusing them is the most likely way to break uploads:
#   S3_ENDPOINT        signs presigned PUTs, and must be browser-reachable.
#   S3_PUBLIC_BASE_URL serves the stored objects.
# In dev both are MinIO on :9100 (9000/9001 are usually taken), so S3_PUBLIC_BASE_URL
# can be left unset and derived. In PROD they diverge — see the R2 block below.
# All dev values below work as-is; a fresh `docker compose up` needs no editing.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=lords-media
# Optional explicit public base; derived as {S3_ENDPOINT}/{S3_BUCKET} when unset.
# S3_PUBLIC_BASE_URL=http://localhost:9100/lords-media
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=900
S3_MAX_UPLOAD_MB=100
# MinIO root credentials (the compose `minio` service + bucket bootstrap use these).
# DEV ONLY — prod has no MinIO; R2 replaces it.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- PRODUCTION: Cloudflare R2 ---
# R2 has no ACL concept, so there is no equivalent of MinIO's public-read bucket
# bootstrap. Public reads come from a CUSTOM DOMAIN bound to the bucket. Do not
# use the r2.dev subdomain — Cloudflare rate-limits it and documents it as
# development-only.
#
# S3_ENDPOINT must be the account S3 endpoint, because presigned URLs work ONLY
# against r2.cloudflarestorage.com and never against a custom domain.
# S3_PUBLIC_BASE_URL must be the custom domain. Leaving it unset derives
# {endpoint}/{bucket}, which is NOT publicly readable — every avatar, rank icon
# and gallery image would fail to load with nothing in the API logs.
#
# S3_REGION is forced to "auto" by docker-compose.prod.yml (R2 requires that
# literal string), so it does not need setting here.
#
# The R2 credentials are an "Object Read & Write" token scoped to this one
# bucket — the API needs READ as well as write, because icon dimension checks do
# a ranged GetObject. The secret is shown exactly once when the token is created.
#
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://cdn.lordsofholdfast.com
# S3_ACCESS_KEY_ID=<R2 token access key id>
# S3_SECRET_ACCESS_KEY=<R2 token secret access key>
# S3_BUCKET=lords-media

# --- PRODUCTION: edge / deploy ---
# SITE_ADDRESS is the Caddy site block — one or more hostnames, comma-separated.
# ACME_EMAIL receives Let's Encrypt expiry notices.
# IMAGE_TAG pins the GHCR images; use a commit SHA so rollback is a tag change.
# SWAGGER_ENABLED=true force-enables /api/docs, which is off in production.
# SITE_ADDRESS=lordsofholdfast.com, www.lordsofholdfast.com
# ACME_EMAIL=you@example.com
# IMAGE_TAG=latest
# SWAGGER_ENABLED=false

# --- Frontend redirect targets (where we send the browser after OAuth) ---
# In the proxied topology these all use the WEB origin (the browser is same-origin
# with the api). Dev: http://localhost:4200. Prod: https://lordsofholdfast.com.
FRONTEND_URL=http://localhost:4200
# Where to land an authenticated user; the JWT is appended as a short-lived handoff.
FRONTEND_AUTH_SUCCESS_REDIRECT=http://localhost:4200/auth/callback
FRONTEND_AUTH_FAILURE_REDIRECT=http://localhost:4200/login

# --- External integrations (optional third-party API keys) ---
# YouTube Data API v3 key: when set, gallery YouTube links are enriched with the
# canonical title + duration (videos.list). Leave blank to fall back to the static
# i.ytimg.com thumbnail with no enrichment. Create a key in the Google Cloud
# Console (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# ───────────────────────────────────────────────────────────────────────────
# PRODUCTION-only (consumed by docker-compose.prod.yml; leave blank for dev)
# ───────────────────────────────────────────────────────────────────────────
# The public origin the web container is served on (drives CORS + OAuth redirects).
WEB_ORIGIN=https://lordsofholdfast.com
# Host port the web (nginx) container publishes; a reverse proxy/Caddy fronts TLS.
WEB_HTTP_PORT=8080
# Claim the REAL regiment Owner on first deploy: the owner's Discord user id, so
# their first sign-in resolves the Owner member. Leave blank in dev (mock owner).
OWNER_DISCORD_ID=

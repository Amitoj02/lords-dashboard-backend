{
  "extends": "./tsconfig.json",
  // TypeScript 6 (TS5011) requires rootDir to be explicit rather than inferred
  // from the common source directory. It belongs here and not in the base
  // config, which also has to cover test/ — that sits outside src/.
  "compilerOptions": {
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}

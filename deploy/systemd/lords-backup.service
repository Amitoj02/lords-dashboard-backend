# Systemd USER unit — installed under ~/.config/systemd/user/, not /etc.
#
# The deploy account already owns the docker socket, the .env and the rclone
# config, and `loginctl enable-linger deploy` is set (so user units run without
# an active login session). That makes root unnecessary for backups, which is
# one less thing holding privilege it does not need.
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now lords-backup.timer
#   systemctl --user start lords-backup.service   # run one now
#   journalctl --user -u lords-backup.service -n 50

[Unit]
Description=Back up the Lords dashboard database to Cloudflare R2
Documentation=file:%h/lords/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/bin/lords-backup

# A user unit's default PATH is /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
# — it does NOT include ~/bin, where bootstrap.sh installs rclone (nothing here
# is allowed to need root). An interactive login shell DOES have ~/bin, via
# Debian's ~/.profile, so anything tested by hand works and the same command
# under this unit does not. The scripts now resolve rclone by absolute path
# regardless; this is the second lock on the same door, and it covers any future
# helper in ~/bin.
Environment=PATH=%h/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

# The dump streams through zstd on a 2 vCore box shared with a live MySQL and
# the API. Keep it off the critical path rather than letting it compete.
Nice=10
IOSchedulingClass=idle

# Generous, but bounded: a hung mysqldump holding a read view open is worse than
# a failed backup, and the timer would otherwise stack runs.
TimeoutStartSec=30min

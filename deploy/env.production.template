# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION environment — lives at ~/lords/.env on the VPS, mode 0600.
#
# Consumed by:  docker compose -f docker-compose.yml -f docker-compose.prod.yml
#
# Values marked ‹GENERATED› are filled in by deploy/bootstrap.sh with real
# random secrets from `openssl rand`. Values marked ‹REQUIRED› are the ones only
# you can supply — the stack will refuse to start until every one is set (the
# compose file uses ${VAR:?} for each, so you get a named error, not a mystery).
#
# NEVER commit this file. Never paste it into a chat, an issue, or a PR.
# ═══════════════════════════════════════════════════════════════════════════

# ── Image tags ──────────────────────────────────────────────────────────────
# One per repository: the api and web images are built from DIFFERENT repos with
# different commit SHAs, so a single shared tag can only ever be right for one.
# lords-deploy rewrites these in place on every deploy; pin to a SHA to roll back.
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest

# ── Site / edge ─────────────────────────────────────────────────────────────
# SITE_ADDRESS is the Caddy site block. Both hostnames, comma-separated — Caddy
# issues a certificate covering each, so www must be listed to work over HTTPS.
SITE_ADDRESS=lordsofholdfast.com, www.lordsofholdfast.com

# The ONE canonical hostname. www redirects here with a 301 so search engines
# index a single copy of every profile instead of splitting signals across two
# identical hostnames (T-0215). Bare host, no scheme, no trailing slash.
APEX_HOST=lordsofholdfast.com

# Let's Encrypt expiry notices go here. A real, monitored mailbox.
ACME_EMAIL=‹REQUIRED: you@example.com›

# The public origin. Drives CORS, the OAuth callback and every post-login
# redirect. MUST include the scheme and no trailing slash.
WEB_ORIGIN=https://lordsofholdfast.com

# ── Database ────────────────────────────────────────────────────────────────
DB_DATABASE=lords_dashboard

# The MySQL root password. Used for MYSQL_ROOT_PASSWORD, the container
# healthcheck and mysqldump. Nothing that serves traffic connects as root.
DB_PASSWORD=‹GENERATED›

# The two least-privilege accounts created on first boot by
# mysql/init/01-app-users.sh. lords_app is DML-only and is what the long-lived
# API uses; lords_migrate holds DDL and is used only by the one-shot migrate
# container, which exits before the API starts.
#
# ⚠️ These are applied ONLY when the db-data volume is first created. Changing
# them later does NOT update MySQL — see deploy/README.md for the rotation SQL.
APP_DB_USERNAME=lords_app
APP_DB_PASSWORD=‹GENERATED›
MIGRATE_DB_USERNAME=lords_migrate
MIGRATE_DB_PASSWORD=‹GENERATED›

# ── Application secrets ─────────────────────────────────────────────────────
# JWT signing key. Rotating it invalidates every session (everyone signs in
# again) — annoying, not destructive.
JWT_SECRET=‹GENERATED›

# AES-256-GCM key for Discord tokens and event passwords at rest. EXACTLY 64 hex
# characters.
#
# ⚠️ ONE-WAY DOOR. The encryption transformer carries no key id or version, so
# there is no way to decrypt old ciphertext with a new key. Rotating this makes
# every stored Discord refresh token and event password permanently unreadable.
# Back it up somewhere you will still have in a year.
ENCRYPTION_KEY=‹GENERATED›

# ── Discord OAuth2 (sign-in) ────────────────────────────────────────────────
# https://discord.com/developers/applications → OAuth2.
# Add this exact redirect: https://lordsofholdfast.com/api/auth/discord/callback
DISCORD_MOCK=false
DISCORD_CLIENT_ID=‹REQUIRED›
DISCORD_CLIENT_SECRET=‹REQUIRED›

# The regiment's Discord server id. Membership is verified against this guild at
# sign-in. Right-click the server → Copy Server ID (needs Developer Mode).
DISCORD_GUILD_ID=‹REQUIRED›

# ── Discord bot (the Quartermaster — role sync + announcements) ─────────────
# ⚠️ LEAVE DISCORD_BOT_MOCK=true FOR NOW.
#
# The plan's Phase 6 is a seven-step rollout into a 576-member guild, and step 5
# (the first real role write) is the first irreversible action against real
# people. Go live with the bot mocked, prove the web app works, then walk the
# ladder. Flipping this to false before the staging-guild rehearsal is the single
# riskiest thing you can do in this file.
DISCORD_BOT_MOCK=true
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Claims the real regiment Owner on FIRST boot: your Discord user id (snowflake).
# On a greenfield database the seeder binds the Owner member to this id, so your
# first sign-in lands you as Owner with setup incomplete.
#
# ⚠️ Only read on a greenfield database. Setting it later does nothing.
OWNER_DISCORD_ID=‹REQUIRED: your Discord user id›

# ── Cloudflare R2 (object storage) ──────────────────────────────────────────
# TWO DIFFERENT HOSTS. Confusing them is the most likely way to break uploads:
#
#   S3_ENDPOINT         signs presigned PUTs. Presigned URLs work ONLY against
#                       <account>.r2.cloudflarestorage.com, never a custom domain.
#   S3_PUBLIC_BASE_URL  serves objects. The custom domain bound to the bucket.
#
# Leaving S3_PUBLIC_BASE_URL unset derives {endpoint}/{bucket}, which is not
# publicly readable — every avatar, rank icon, medal and gallery image would fail
# to load with nothing at all in the API logs.
#
# S3_REGION is hardcoded to "auto" in docker-compose.prod.yml (R2 requires that
# literal string), so it is deliberately not set here.
S3_ENDPOINT=‹REQUIRED: https://<ACCOUNT_ID>.r2.cloudflarestorage.com›
S3_PUBLIC_BASE_URL=https://cdn.lordsofholdfast.com
S3_BUCKET=lords-media
S3_FORCE_PATH_STYLE=true

# An "Object Read & Write" R2 API token scoped to lords-media. READ is required
# as well as write — the icon dimension check does a ranged GetObject to parse
# PNG/WebP headers. The secret is shown exactly once when you create the token,
# and new keys can take up to a minute to propagate.
S3_ACCESS_KEY_ID=‹REQUIRED: R2 token access key id›
S3_SECRET_ACCESS_KEY=‹REQUIRED: R2 token secret access key›

# ── Optional ────────────────────────────────────────────────────────────────
# YouTube Data API v3 key. When set, gallery YouTube links get their canonical
# title and duration. Without it, links still work with a static thumbnail.
YOUTUBE_API_KEY=

# Force-enable Swagger at /api/docs, which is OFF in production. Leave unset.
# SWAGGER_ENABLED=true

# Backup configuration — copy to ~/lords/backup.env and chmod 600.
# Consumed by deploy/bin/lords-backup and deploy/bin/lords-restore-drill.

# rclone remote name, as defined in ~/.config/rclone/rclone.conf.
RCLONE_REMOTE=r2

# R2 bucket for backups. Keep this SEPARATE from lords-media: the media bucket
# is public-read via the cdn custom domain, and database dumps must never be
# reachable that way.
BACKUP_BUCKET=lords-backups

# How long to keep dumps. 30 days of nightlies is roughly 30 x the dump size;
# for a regiment of <600 members that is comfortably inside R2's 10 GB free tier.
BACKUP_RETENTION_DAYS=30

# Hard floor, in bytes, below which the dump is treated as failed. A schema-only
# dump from an auth failure still compresses to a valid archive of a few KB —
# this is what catches it. Raise it once you know the real dump size.
BACKUP_MIN_BYTES=20000

# Better Stack (or any) heartbeat URL, pinged ONLY on success. The monitor
# alerts on the ping's ABSENCE, which is the only way to detect the timer
# silently not running at all. Leave blank to disable.
BACKUP_HEARTBEAT_URL=

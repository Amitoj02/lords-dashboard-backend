# ─────────────────────────────────────────────────────────────────────────────
# Edge for the Lords Regiment Dashboard. Caddy is the ONLY container that
# publishes host ports; everything else is reachable only on the compose network.
#
# Caddy handles ACME automatically (including Let's Encrypt's move to 64- then
# 45-day certificates via ARI), so there is no certbot, no renewal timer and no
# reload hook. The caddy_data volume MUST persist — it holds certificates and
# keys, and losing it re-issues on every deploy, which walks straight into Let's
# Encrypt's 5-duplicate-certificates-per-7-days limit.
# ─────────────────────────────────────────────────────────────────────────────
{
	email {$ACME_EMAIL}

	# Trust Cloudflare so the real client IP survives to the API. Caddy ignores
	# inbound X-Forwarded-For from untrusted peers by default, which is what stops
	# a client forging the address used for logs and rate limiting.
	#
	# ⚠️ Refresh this list from https://www.cloudflare.com/ips-v4 and /ips-v6 —
	# it changes. A stale list silently breaks real-IP restoration.
	servers {
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

{$SITE_ADDRESS} {
	import security

	# LDA-H3 — Authenticated Origin Pulls (mTLS), as an OPT-IN overlay.
	#
	# When the box mounts an overlay into /etc/caddy/aop/ (a client-auth snippet
	# plus Cloudflare's origin-pull CA), that snippet adds a `tls { client_auth
	# require_and_verify }` policy here, so the origin refuses any TLS handshake
	# that did not arrive through Cloudflare. That is what makes trusting
	# Cf-Connecting-Ip for rate limiting sound: a client reaching the origin
	# directly can no longer be served, let alone forge the address used for logs
	# and throttling. Zone-level AOP presents Cloudflare's SHARED cert (CN
	# origin-pull.cloudflare.net), so this proves "arrived via some Cloudflare
	# zone", which is enough to close the direct-origin bypass.
	#
	# A non-matching glob is a no-op (an empty glob is not an error in Caddy), so a
	# clone — or any deploy without the overlay — serves normally and can never
	# boot into a lockout. ORDER MATTERS when enabling: turn on zone-level AOP in
	# the Cloudflare dashboard FIRST (so Cloudflare actually presents its client
	# cert), THEN drop the overlay in — otherwise the origin requires a cert
	# Cloudflare is not sending yet and every request 520s. ACME renewal is
	# unaffected: it runs over HTTP-01 on :80, not this :443 client-auth policy.
	# See deploy/README.md ("Authenticated Origin Pulls").
	import /etc/caddy/aop/*.caddy

	# CSP derived from what the frontend actually loads.
	#
	# - style-src needs 'unsafe-inline' because Angular injects component styles at
	#   runtime. This is an INFRASTRUCTURE limit, not a framework one: Angular has
	#   supported nonces via ngCspNonce/CSP_NONCE since v16, but a nonce must be
	#   unique per request and a statically-served build has nothing to mint one.
	# - connect-src must include the R2 *signing* endpoint, not the CDN domain:
	#   presigned PUTs go to <account>.r2.cloudflarestorage.com and only ever work
	#   against that host. Uploads fail with an opaque CSP error otherwise.
	# - Medal thumbnails are proxied same-origin by the API, so medal.tv is needed
	#   only in frame-src, not img-src.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: {$CDN_ORIGIN} https://i.ytimg.com https://cdn.discordapp.com; media-src 'self' {$CDN_ORIGIN}; connect-src 'self' {$R2_S3_ORIGIN}; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://medal.tv; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

	encode zstd gzip

	# ── One canonical hostname (T-0215) ────────────────────────────────────────
	#
	# SITE_ADDRESS lists BOTH hostnames, so apex and www have always served
	# identical content at 200 with no canonical link between them. That is
	# harmless while nothing is indexed and a real problem the moment it is:
	# Google sees two complete copies of every profile and splits the ranking
	# signals between them. 301 rather than 302 — the hostname choice is
	# permanent in a way a vanity handle is not.
	@www host www.{$APEX_HOST}
	redir @www https://{$APEX_HOST}{uri} permanent

	# ── The legacy gallery share path (T-0197, superseded by @crawler in T-0293) ─
	#
	# `/api/share/gallery/:id` and `/api/seo/gallery/:id` render from the SAME
	# service, so this block and the one below produce identical bytes. It is kept
	# for exactly one reason: this file is HAND-SYNCED to the box, so between an
	# API deploy and someone SSHing in, whichever version of the Caddyfile is
	# live has to keep working. Delete it only once the box is confirmed to be
	# running the config below.
	#
	# ⚠️ MUST STAY ABOVE `handle /api/*`. Sibling `handle` blocks are mutually
	# exclusive and evaluated in file order.
	@unfurler {
		path /gallery/*
		header_regexp User-Agent "(?i)(discordbot|facebookexternalhit|twitterbot|whatsapp|slackbot|telegrambot|linkedinbot|redditbot|skypeuripreview|iframely|embedly|googlebot|bingbot|applebot|mastodon|matrix|signal)"
	}
	handle @unfurler {
		rewrite * /api/share{uri}
		reverse_proxy api:3000
	}

	# ── Every public page, for search engines and unfurlers (T-0215/T-0293) ─────
	#
	# These are all SPA routes, and the SPA is a static client-side build, so a
	# client that does not run JavaScript receives one <app-root></app-root> that
	# is byte-identical for every member, every event and every dispatch on the
	# site — no name, no rank, no banner, nothing to index and nothing to unfurl.
	# NO unfurler runs JavaScript, so this rewrite is not an optimisation for
	# them; it is the only thing that makes a link preview exist at all.
	#
	# These requests go to /api/seo/*, which renders the same facts the SPA
	# renders, as real HTML with rel=canonical, og:*/twitter:*, JSON-LD, crawlable
	# <a href> links, and — crucially — HONEST STATUS CODES. The SPA cannot return
	# one: nginx 200s everything, so a deleted profile is a soft-404.
	#
	# ⚠️ THE PATH LIST IS EXACT, AND THE BARE FORMS ARE NOT REDUNDANT. Caddy's
	# path matcher treats slashes as significant: `/gallery/*` matches `/gallery/`
	# and `/gallery/abc` but NOT `/gallery`. Both spellings of every list page
	# have to be written out, which is why `/roster` already sat beside
	# `/roster/*` before this grew.
	#
	# ⚠️ `/` IS DELIBERATELY ABSENT, and `/home` is here in its place. They render
	# the same landing component, but `/` is the one path a Cloudflare Cache Rule
	# covers — and Cloudflare honours `Vary` for `Accept-Encoding` and nothing
	# else, so a UA-varying `/` would eventually put this crawler document in the
	# edge cache and serve it to every human. `/home` is the URL the router
	# redirects `/` to and the one both surfaces declare canonical, so nothing is
	# lost. Do not add `/` here without changing the Cloudflare rule first.
	#
	# ⚠️ Same caveat for the rest: if a Cloudflare cache rule is ever added for
	# /roster, /u/*, /events*, /gallery* or /home, it must key on User-Agent or
	# humans get the shell. The API already sends `Vary: User-Agent`.
	#
	# ⚠️ WHAT IS SERVED HERE MUST STAY EQUIVALENT TO WHAT A HUMAN SEES. Both come
	# from the same services and the same exclusion predicates, which is what
	# keeps this dynamic rendering rather than cloaking. Do not "optimise" the
	# shell down to bare meta tags.
	#
	# ⚠️ MUST STAY ABOVE `handle /api/*`, like @unfurler, and for the same reason.
	#
	# ⚠️ SHIP THE API FIRST. Every path listed here needs a route under
	# /api/seo/*; one that does not have one returns a JSON 404, which an
	# unfurler renders as a broken preview.
	@crawler {
		path /u/* /roster /roster/* /events /events/* /gallery /gallery/* /home
		header_regexp User-Agent "(?i)(discordbot|facebookexternalhit|twitterbot|whatsapp|slackbot|telegrambot|linkedinbot|redditbot|skypeuripreview|iframely|embedly|googlebot|bingbot|applebot|duckduckbot|yandexbot|mastodon|matrix|signal)"
	}
	handle @crawler {
		rewrite * /api/seo{uri}
		reverse_proxy api:3000
	}

	# The sitemap is generated from live data (it has to enumerate every public
	# profile), so it cannot be a static file in the frontend image. Without this
	# block /sitemap.xml falls into the SPA handle below and returns 200 text/html
	# — an invalid sitemap that Search Console rejects without explaining why.
	# robots.txt IS static and ships in the web image; it does not belong here.
	handle /sitemap.xml {
		rewrite * /api/sitemap.xml
		reverse_proxy api:3000
	}

	# handle blocks are mutually exclusive, so /api/* can never fall through to the
	# SPA fallback below and return index.html for a missing endpoint.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Everything else goes to the `web` image, which is a self-contained nginx
	# serving the Angular build. Deliberately NOT served from a shared volume:
	# a named volume populated from the image would not refresh on redeploy, so
	# the site would silently keep serving the previous release's bundle.
	# Keeping the SPA inside its own versioned image makes a rollback a tag change.
	# nginx.conf in the frontend repo owns the history-API fallback and the
	# long-cache headers for hashed assets.
	handle {
		reverse_proxy web:80

		# index.html must NEVER be cached. A stale index.html referencing hashed
		# chunks that no longer exist is the classic white-screen-after-deploy bug,
		# which is why it is enforced here at the origin AS WELL AS in a Cloudflare
		# Cache Rule — belt and braces.
		@html path / /index.html
		header @html Cache-Control "no-cache, no-store, must-revalidate"
	}
}
